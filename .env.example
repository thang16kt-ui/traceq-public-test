# Development only. Generate a private .env with python scripts/configure.py.
# Hex password is URL-safe; replace the sample before starting.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
APP_DATABASE_PASSWORD=REPLACE_WITH_APP_RANDOM_HEX
POSTGRES_DB=traceq
APP_ORIGIN=http://localhost:8080
COOKIE_SECURE=false
ENVIRONMENT=development
HTTP_PORT=8080
SESSION_HOURS=12
# HTTPS: point DNS to server, set APP_ORIGIN=https://your-domain and COOKIE_SECURE=true.
APP_DOMAIN=localhost
# Web Push (tùy chọn): sinh bằng `python -m backend.app.cli generate-vapid`. Khóa riêng là BÍ MẬT.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:quanly@example.invalid
